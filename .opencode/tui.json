{
    "$schema": "https://opencode.ai/tui.json",
    "theme": "system",
    "scroll_speed": 3,
    "scroll_acceleration": {
        "enabled": true
    },
    "diff_style": "auto",
    "cursor": {
        "style": "block",
        "blinking": true
    },
    "mouse": true,
    "attention": {
        "enabled": true,
        "notifications": true,
        "sound": true,
        "volume": 0.4
    }
}